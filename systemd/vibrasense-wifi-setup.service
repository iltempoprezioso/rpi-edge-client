[Unit]
Description=VibraSense WiFi Setup Service
After=NetworkManager.service network-online.target
Wants=network-online.target
Requires=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/iltempoprezioso/rpi-edge-client
ExecStart=/home/iltempoprezioso/rpi-edge-client/venv/bin/python3 /home/iltempoprezioso/rpi-edge-client/scripts/wifi_setup.py
Restart=no
StandardOutput=journal
StandardError=journal

# Only run if WiFi is not configured
ConditionPathExists=!/home/iltempoprezioso/rpi-edge-client/.wifi_configured

[Install]
WantedBy=multi-user.target
