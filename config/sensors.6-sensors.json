{
  "machine_id": 1,
  "company_id": 1,
  "machine_name": "UnitaPresidioMacchina001",
  "location": "Production Floor",
  "sensors": [
    {
      "sensor_id": 1,
      "name": "Vibrazioni Mandrino",
      "type": "vibration",
      "driver": "ism330dhcx",
      "enabled": true,
      "config": {
        "address": "0x6A",
        "bus": 1,
        "accel_range": 4,
        "gyro_range": 250,
        "sampling_rate": 104,
        "enable_gyro": true
      },
      "processing": {
        "filters": {
          "highpass": 1.0,
          "lowpass": 500.0,
          "notch": 50.0
        },
        "calculate": ["rms", "peak", "peak_to_peak"],
        "fft_enabled": true,
        "fft_samples": 4096,
        "fft_sampling_rate": 6660
      },
      "thresholds": {
        "warning": {
          "accel_rms": 2.0,
          "gyro_rms": 50.0
        },
        "critical": {
          "accel_rms": 5.0,
          "gyro_rms": 100.0
        }
      },
      "notes": "ISM330DHCX @ 0x6A - Vibrazione mandrino principale"
    },
    {
      "sensor_id": 2,
      "name": "Vibrazioni Assi",
      "type": "vibration",
      "driver": "ism330dhcx",
      "enabled": true,
      "config": {
        "address": "0x6B",
        "bus": 1,
        "accel_range": 4,
        "gyro_range": 250,
        "sampling_rate": 104,
        "enable_gyro": true
      },
      "processing": {
        "filters": {
          "highpass": 1.0,
          "lowpass": 500.0,
          "notch": 50.0
        },
        "calculate": ["rms", "peak", "peak_to_peak"],
        "fft_enabled": true,
        "fft_samples": 4096,
        "fft_sampling_rate": 6660
      },
      "thresholds": {
        "warning": {
          "accel_rms": 2.0,
          "gyro_rms": 50.0
        },
        "critical": {
          "accel_rms": 5.0,
          "gyro_rms": 100.0
        }
      },
      "notes": "ISM330DHCX @ 0x6B - Vibrazione assi X/Y/Z"
    },
    {
      "sensor_id": 3,
      "name": "Temperatura Cuscinetto Mandrino",
      "type": "temperature",
      "driver": "max6675",
      "enabled": true,
      "config": {
        "cs_pin": 0,
        "bus": 0,
        "max_speed_hz": 1000000
      },
